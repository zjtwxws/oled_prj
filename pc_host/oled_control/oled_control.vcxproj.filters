<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="Source"><UniqueIdentifier>{src}</UniqueIdentifier></Filter>
    <Filter Include="Header"><UniqueIdentifier>{hdr}</UniqueIdentifier></Filter>
    <Filter Include="Resource"><UniqueIdentifier>{res}</UniqueIdentifier></Filter>
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp"><Filter>Source</Filter></ClCompile>
    <ClCompile Include="serial_port.cpp"><Filter>Source</Filter></ClCompile>
    <ClCompile Include="protocol.cpp"><Filter>Source</Filter></ClCompile>
    <ClCompile Include="oled_preview.cpp"><Filter>Source</Filter></ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="resource.h"><Filter>Header</Filter></ClInclude>
    <ClInclude Include="serial_port.h"><Filter>Header</Filter></ClInclude>
    <ClInclude Include="protocol.h"><Filter>Header</Filter></ClInclude>
    <ClInclude Include="frame_queue.h"><Filter>Header</Filter></ClInclude>
    <ClInclude Include="oled_preview.h"><Filter>Header</Filter></ClInclude>
    <ClInclude Include="oled_preview_gen.h"><Filter>Header</Filter></ClInclude>
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="oled_control.rc"><Filter>Resource</Filter></ResourceCompile>
  </ItemGroup>
</Project>
